# Netlify y Cloudflare Pages leen este archivo.
# Las partes de los modelos llevan su huella en el nombre: se pueden guardar para siempre.
/models/partes/*
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=31536000, immutable
# Sin caché para el service worker y la página, así los teléfonos reciben las versiones nuevas.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
